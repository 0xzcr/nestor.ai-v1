# Supabase (for auth and file storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI (embeddings only - Gemini embedding-001)
GOOGLE_API_KEY=

# Cerebras AI (generation - Claude 3.5 Sonnet)
CEREBRAS_API_KEY=

# Qdrant (local Docker or cloud)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=  # Leave empty for local Docker. Set a key only if using a secured Qdrant deployment.

# Redis (local Docker or cloud)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=  # Optional: use only when your Redis provider gives a separate token.

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
